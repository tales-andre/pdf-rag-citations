# Copy to .env and edit. Without a .env the app runs in extractive mode (no LLM, fully offline).

# Folder with your PDFs (when running without Docker). With Docker, set PDF_FOLDER instead.
# DOCS_DIR=./sample_docs
# PDF_FOLDER=./sample_docs

# Retrieval and refusal
TOP_K=4
# Refuse when the best passage covers less than this share of the question (0..1).
MIN_CONFIDENCE=0.5
MIN_SENTENCE_COVERAGE=0.34

# LLM provider: none | openai | anthropic | gemini | ollama
LLM_PROVIDER=none
# Model name for the provider, for example:
#   openai: gpt-4.1-mini   anthropic: claude-opus-5   gemini: gemini-2.5-flash   ollama: llama3.1
LLM_MODEL=

# API keys (only the one for your provider). Never commit real keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Ollama runs on your own machine; nothing leaves it.
# From inside Docker use http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434

# With Docker: set to 1 to install the provider packages in the image.
WITH_LLM=0
